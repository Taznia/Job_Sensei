# Copy this file to `.figma.env` and paste your own token in.
# `.figma.env` is gitignored — never commit the real token.
#
# Create a token at: figma.com -> your avatar -> Settings -> Security tab
#                    -> Personal access tokens -> Generate new token
# Scope needed: "File content" (read-only). Nothing else.

FIGMA_TOKEN=figd_paste_your_token_here
